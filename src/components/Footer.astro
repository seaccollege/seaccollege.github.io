---
import Social from "./Social.astro";
import BottomNavLinks from "./BottomNavLinks.astro";
import ScrollTop from "./widgets/ScrollTop.svelte";
import GitHubLink from "./links/GitHubLink.svelte";

const year = new Date().getFullYear();
---

<!-- Footer -->
<footer
    class="bg-slate-900 text-slate-200 bottom-0 left-0 w-full z-40"
    role="contentinfo"
>
    <div class="max-w-7xl mx-auto px-6 py-6">
        <ScrollTop />

        <!-- <BottomNavLinks /> -->

        <div
            class="mt-8 border-t border-slate-700 pt-6 flex flex-col md:flex-row md:items-center md:justify-center gap-4"
        >
            <p>
                &copy; {year} South Eastern Arabic College. All rights reserved.
            </p>
            <p>
                <Social />
            </p>
        </div>
        <div>
            <GitHubLink />
        </div>
    </div>
</footer>
