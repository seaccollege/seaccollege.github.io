---
// Admission Page Contents Component
---

<section class="admission-hero">
    <div class="hero-content">
        <h1 class="admission-title">Admissions</h1>
        <p class="admission-subtitle">Apply to South Eastern Arabic College</p>
        <div class="decorative-line"></div>
    </div>
</section>

<section class="admission-container">
    <div class="admission-intro">
        <h2>Applications Now Open</h2>
        <p>We welcome students who are ready to learn and grow. Our college offers quality education in a supportive environment.</p>
    </div>

    <div class="cta-section">
        <h2>Ready to Apply?</h2>
        <p>Complete your application online</p>
        <a id="admissionLink" href="https://seaccollege.netlify.app" rel="noopener" class="apply-button">
            <span class="button-text">Apply Online</span>
            <span class="button-icon">→</span>
        </a>
        <p class="cta-note">Opens in a new window</p>
    </div>

    <div class="contact-section">
        <h2>Need Help?</h2>
        <p>Our admissions team is available to answer your questions.</p>
        <div class="contact-details">
            <div class="contact-item">
                <span class="contact-icon">📧</span>
                <span>Send us an email</span>
            </div>
            <div class="contact-item">
                <span class="contact-icon">📞</span>
                <span>Call us</span>
            </div>
        </div>
    </div>
</section>

<style>
    @import "../../styles/admission-page.css";
</style>
