---
import Social from "./Social.astro";
import BottomNavLinks from "./BottomNavLinks.astro";

const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-200 bottom-0 left-0 w-full z-40">
    <div class="max-w-7xl mx-auto px-6 py-6">
        <div class="md:flex md:items-center md:justify-between">
            <div class="flex items-center space-x-4">
                <a href="/" class="flex items-center gap-3 text-white">
                    <svg
                        class="h-8 w-8 text-indigo-400"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true"
                    >
                        <circle cx="12" cy="12" r="10" fill="currentColor"
                        ></circle>
                        <path
                            d="M8 14l2.5-3L16 15"
                            stroke="#0f172a"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </a>
            </div>

            <!-- <BottomNavLinks /> -->

        <div
            class="mt-8 border-t border-slate-700 pt-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4"
        >
            <p class="text-sm text-slate-400">
                © {year} South Eastern Arabic College. All rights reserved.
            </p>

            <div class="flex items-center space-x-4">
                <a
                    href="https://github.com/seaccollege"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 hover:text-white"
                    aria-label="SEAC GitHub"
                >
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M12 .5C5.73.5.78 5.45.78 11.72c0 4.87 3.16 8.99 7.55 10.45.55.1.75-.24.75-.53 0-.26-.01-1.13-.02-2.05-3.07.67-3.72-1.48-3.72-1.48-.5-1.27-1.22-1.61-1.22-1.61-.99-.68.08-.67.08-.67 1.09.08 1.66 1.12 1.66 1.12.97 1.66 2.55 1.18 3.17.9.1-.71.38-1.18.69-1.45-2.45-.28-5.02-1.22-5.02-5.43 0-1.2.43-2.18 1.12-2.95-.11-.28-.49-1.41.11-2.95 0 0 .9-.29 2.95 1.12a10.2 10.2 0 0 1 2.69-.36c.91 0 1.83.12 2.69.36 2.05-1.41 2.95-1.12 2.95-1.12.6 1.54.22 2.67.11 2.95.7.77 1.12 1.75 1.12 2.95 0 4.22-2.58 5.15-5.04 5.42.39.33.73.98.73 1.98 0 1.43-.01 2.58-.01 2.93 0 .29.2.64.76.53C20.06 20.71 23.22 16.6 23.22 11.72 23.22 5.45 18.27.5 12 .5z"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</footer>