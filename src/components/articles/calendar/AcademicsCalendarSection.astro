---
import UnderProcess from "../../angular/under-process/under-process.component.html";
---

<section id="programs" aria-labelledby="programs-title">
    <h2 id="programs-title">Academic Calendar <UnderProcess /></h2>
    <p>
        The college timetable is regularly updated to manage ongoing activities
        and programs. A <strong>fixed academic calendar</strong> will be published
        soon to guide students, parents, and staff in planning for classes, assessments,
        and events.
    </p>
</section>

<style>
    @import "../../../styles/academics-page.css";

    h2 {
        color : var(--academics-title-color);
    }

    h2::after {
    background: var(--academics-header-gradient);
    }
</style>
