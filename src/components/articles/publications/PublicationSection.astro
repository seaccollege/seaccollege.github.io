---
import Publications1 from "./Publications1.astro";
import Publications2 from "./Publications2.astro";
import Publications3 from "./Publications3.astro";
import UnderProcess from "../../angular/under-process/under-process.component.html";
---

<section id="programs" aria-labelledby="programs-title">
    <h2 id="programs-title">Publications</h2>
    <p>
        The college provides high-quality learning resources to support both
        students and teachers: <UnderProcess />
        <div class="programs-grid" role="list">
            <Publications1 />
            <Publications2 />
            <Publications3 />
        </div>
    </p>
</section>

<style>
    @import "../../../styles/academics-page.css";

    h2 {
        color : var(--academics-title-color);
    }

    h2::after {
    background: var(--academics-header-gradient);
    }
</style>
