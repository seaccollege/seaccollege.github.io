---
import HomeLayout from "../layouts/HomeLayout.astro";
import AboutPageContents from "../components/contents/about-page-contents.astro";
---

<HomeLayout title="About South Eastern Arabic College" description="Learn more about South Eastern Arabic College, our mission, values, and the services we provide to the community.">
    <main id="main-content" role="main">
        <AboutPageContents />
    </main>
</HomeLayout>

<style>
    main {
        padding: 3rem;
    }

    @media (max-width: 768px) {
        main {
            padding: 1rem;
        }
    }
</style>