        <div class="header-logo-badge">
            <a href = "/">
                <LogoBadge />
            </a>
        </div>
        <LogoTitle />
        <MobileMenuToggle />
        <NavLinks />
    </nav>
</header>

<style>
    @import "../styles/header.css";
</style>